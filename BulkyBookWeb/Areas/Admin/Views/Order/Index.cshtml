@using BulkyBook.Utility
@{
    var status = Context.Request.Query["status"].ToString().ToLower();
    var view = Context.Request.Query["view"].ToString().ToLower();
    var isStaff = User.IsInRole(SD.RoleAdmin) || User.IsInRole(SD.RoleEmployee);
    var showBoard = isStaff && string.IsNullOrEmpty(status) && view != "table";
    string A(bool on) => on ? "active" : "";
    var all = string.IsNullOrEmpty(status) || status == "all";
    var wrapper = isStaff ? "" : "container my-4 pt-3";
}
<div class="@wrapper">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 reveal">
        <div class="seg">
            <a class="@A(all)" asp-controller="Order" asp-action="Index" asp-route-status="all">All</a>
            <a class="@A(status == "pending")" asp-controller="Order" asp-action="Index" asp-route-status="pending">Pending</a>
            <a class="@A(status == "approved")" asp-controller="Order" asp-action="Index" asp-route-status="approved">Approved</a>
            <a class="@A(status == "processing")" asp-controller="Order" asp-action="Index" asp-route-status="processing">In process</a>
            <a class="@A(status == "shipped")" asp-controller="Order" asp-action="Index" asp-route-status="shipped">Shipped</a>
            <a class="@A(status == "cancelled")" asp-controller="Order" asp-action="Index" asp-route-status="cancelled">Cancelled</a>
        </div>
        @if (isStaff)
        {
            <div class="seg">
                <a class="@A(showBoard)" asp-controller="Order" asp-action="Index"><i class="bi bi-kanban me-1"></i>Board</a>
                <a class="@A(!showBoard)" asp-controller="Order" asp-action="Index" asp-route-view="table"><i class="bi bi-table me-1"></i>Table</a>
            </div>
        }
        else
        {
            <h1 class="h4 fw-bold mb-0">My orders</h1>
        }
    </div>

    @if (showBoard)
    {
        <div class="board" id="board">
            @for (var i = 0; i < 5; i++) { <div class="b-col glass"><div class="au-skeleton" style="height:22px;width:60%"></div><div class="au-skeleton" style="height:96px"></div><div class="au-skeleton" style="height:96px"></div></div> }
        </div>
    }
    else
    {
        <section class="glass reveal in" style="border-radius:var(--au-radius-xl)">
            <div class="table-responsive p-2">
                <table id="tbldata" class="table-styled">
                    <thead>
                        <tr><th>Id</th><th>Name</th><th>Phone</th><th>Email</th><th>Status</th><th>Total</th><th class="text-end">Actions</th></tr>
                    </thead>
                </table>
            </div>
        </section>
    }
</div>

@section Scripts {
    @if (showBoard)
    {
        <script src="~/js/orders-board.js" asp-append-version="true"></script>
    }
    else
    {
        <script src="~/js/orders.js" asp-append-version="true"></script>
    }
}
