@using BulkyBook.Models.ViewModels
@model ProductVM

<div class="container-fluid">

    <a asp-controller="Product" asp-action="Index"
       class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Back to Products
    </a>

    <div class="card border shadow-sm overflow-hidden">

        <div class="card-header text-white py-3 px-4"
             style="background:linear-gradient(to right,#065f46,#282828,#191414);">

            <h5 class="mb-0 fw-bold">

                @if (Model.Product.Id == 0)
                {
                    <i class="bi bi-plus-lg me-2"></i>
                    <span>Create Product</span>
                }
                else
                {
                    <i class="bi bi-pencil-square me-2"></i>
                    <span>Update Product</span>
                }

            </h5>

            <p class="mb-0 small" style="color:#1DB954;">
                @(Model.Product.Id == 0 ? "Add a new product" : "Update existing product")
            </p>

        </div>

        <div class="card-body p-4">

            <form method="post" enctype="multipart/form-data">

                <input asp-for="Product.Id" hidden />
                <input asp-for="Product.ImageUrl" hidden />

                <div class="row">

                    <div class="col-lg-8">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">

                            <div class="col-12">
                                <label asp-for="Product.Title" class="form-label fw-semibold small"></label>
                                <input asp-for="Product.Title" class="form-control" />
                                <span asp-validation-for="Product.Title" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Product.Description"  class="form-label fw-semibold small"></label>
                                <textarea asp-for="Product.Description" hidden class="form-control" rows="4"></textarea>
                                <div id="quill-editor" style="height: 200px">  </div>
                                <span asp-validation-for="Product.Description" class="text-danger"></span>
                            </div>

                            <div class="col-6">
                                <label asp-for="Product.ISBN" class="form-label fw-semibold small"></label>
                                <input asp-for="Product.ISBN" class="form-control" />
                                <span asp-validation-for="Product.ISBN" class="text-danger"></span>
                            </div>

                            <div class="col-6">
                                <label asp-for="Product.Author" class="form-label fw-semibold small"></label>
                                <input asp-for="Product.Author" class="form-control" />
                                <span asp-validation-for="Product.Author" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="border rounded p-3 mt-4">

                            <p class="text-uppercase fw-semibold text-secondary mb-3"
                               style="font-size:.65rem;letter-spacing:.1rem;">
                                Pricing
                            </p>

                            <div class="row g-3">

                                <div class="col-md-3">
                                    <label asp-for="Product.ListPrice"></label>
                                    <input asp-for="Product.ListPrice" class="form-control" />
                                    <span asp-validation-for="Product.ListPrice" class="text-danger"></span>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="Product.Price"></label>
                                    <input asp-for="Product.Price" class="form-control" />
                                    <span asp-validation-for="Product.Price" class="text-danger"></span>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="Product.Price50"></label>
                                    <input asp-for="Product.Price50" class="form-control" />
                                    <span asp-validation-for="Product.Price50" class="text-danger"></span>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="Product.Price100"></label>
                                    <input asp-for="Product.Price100" class="form-control" />
                                    <span asp-validation-for="Product.Price100" class="text-danger"></span>
                                </div>

                            </div>

                        </div>

                        <div class="mt-4">

                            <label asp-for="Product.CategoryId"></label>

                            <select asp-for="Product.CategoryId"
                                    asp-items="Model.CategoryList"
                                    class="form-select">

                                <option disabled selected value="">-- Select Category --</option>

                            </select>

                            <span asp-validation-for="Product.CategoryId" class="text-danger"></span>

                        </div>

                        <div class="mt-4">

                            <label class="form-label fw-semibold">
                                Product Image
                            </label>

                            <input type="file"
                                   name="file"
                                   class="form-control"
                                   accept="image/*" />

                        </div>

                    </div>

                    <div class="col-lg-4">

                        <div class="border rounded p-3 bg-light text-center">

                            <p class="text-uppercase fw-semibold text-secondary mb-3"
                               style="font-size:.65rem;letter-spacing:.1rem;">
                                Current Image
                            </p>

                            @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                            {
                                <img src="/@Model.Product.ImageUrl"
                                     class="img-fluid rounded shadow"
                                     style="max-height:250px;" />
                            }
                            else
                            {
                                <div class="py-5">

                                    <i class="bi bi-image text-secondary"
                                       style="font-size:4rem;"></i>

                                    <p class="text-secondary mt-3">
                                        No Image Available
                                    </p>

                                </div>
                            }

                        </div>

                    </div>

                </div>

                <div class="mt-4">

                    @if (Model.Product.Id == 0)
                    {
                        <button class="btn btn-success">
                            <i class="bi bi-plus-circle"></i>
                            Create Product
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary">
                            <i class="bi bi-pencil-square"></i>
                            Update Product
                        </button>
                    }

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <!-- Include stylesheet -->
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

    <!-- Create the editor container -->

    <!-- Include the Quill library -->
        
    <!-- Initialize Quill editor -->
    <script>
        const quill = new Quill('#quill-editor', {
        theme: 'snow'
        });
        const TextAreaDesc = document.querySelector('tesxtarea[name="Product.Description"]');
        if(TextAreaDesc.value)quill.root.innerHTML= TextAreaDesc.value;
        quill.on('text-change',()=> TextAreaDesc.value = quill.root.innerHTML);
    </script>
    
}