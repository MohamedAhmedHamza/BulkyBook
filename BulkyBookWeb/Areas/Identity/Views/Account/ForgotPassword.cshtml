@model ForgotPasswordVM
@{ ViewData["Title"] = "Forgot password"; }
<div class="bb-auth">
    <div class="bb-auth-card">
        <div class="bb-auth-head">
            <div class="bb-auth-icon"><i class="bi bi-key"></i></div>
            <h1>Forgot your password?</h1>
            <p>Enter your e-mail and we'll send you a 6-digit code.</p>
        </div>
        <div class="bb-auth-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-brand btn-lg w-100">Send code</button>
            </form>
        </div>
        <div class="bb-auth-foot"><a asp-action="Login" class="fw-semibold text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Back to log in</a></div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
