@{ ViewData["Title"] = "Password updated"; }
<div class="bb-status">
    <div style="max-width:440px">
        <div class="bb-status-icon"><i class="bi bi-check-lg"></i></div>
        <h1 class="h3 fw-bold mb-2">Password updated</h1>
        <p class="text-secondary mb-4">You can now log in with your new password.</p>
        <a class="btn btn-brand" asp-action="Login">Log in</a>
    </div>
</div>
