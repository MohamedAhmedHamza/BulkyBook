@model ResetPasswordTokenVM
@{ ViewData["Title"] = "Reset password"; }
<div class="bb-auth">
    <div class="bb-auth-card">
        <div class="bb-auth-head">
            <div class="bb-auth-icon"><i class="bi bi-shield-lock"></i></div>
            <h1>Choose a new password</h1>
            <p>@Model.Email</p>
        </div>
        <div class="bb-auth-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-brand btn-lg w-100">Reset password</button>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
