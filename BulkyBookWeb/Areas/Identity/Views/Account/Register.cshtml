@using BulkyBook.Utility
@model RegiesterVM
@{ ViewData["Title"] = "Create account"; }
<div class="bb-auth">
    <div class="bb-auth-card wide">
        <div class="bb-auth-head">
            <div class="bb-auth-icon"><i class="bi bi-person-plus"></i></div>
            <h1>Create your account</h1>
            <p>Join BulkyBook in a minute</p>
        </div>
        <div class="bb-auth-body">
            <form method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="Full name" autocomplete="name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StreetAddress" class="form-label"></label>
                        <input asp-for="StreetAddress" class="form-control" autocomplete="street-address" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="State" class="form-label"></label>
                        <input asp-for="State" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PostalCode" class="form-label"></label>
                        <input asp-for="PostalCode" class="form-control" autocomplete="postal-code" />
                    </div>
                    @if (User.IsInRole(SD.RoleAdmin))
                    {
                        <div class="col-12">
                            <label asp-for="Role" class="form-label"></label>
                            <select asp-for="Role" asp-items="@Model.RoleList" class="form-select"></select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>
                    }
                </div>
                <button type="submit" class="btn btn-brand btn-lg w-100 mt-4">Create account</button>
            </form>
        </div>
        <div class="bb-auth-foot">
            Already have an account? <a asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="fw-semibold text-decoration-none">Log in</a>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
