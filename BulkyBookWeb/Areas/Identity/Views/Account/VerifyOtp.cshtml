@model VerifyOtpVM
@{ ViewData["Title"] = "Enter your code"; }
<div class="bb-auth">
    <div class="bb-auth-card">
        <div class="bb-auth-head">
            <div class="bb-auth-icon"><i class="bi bi-envelope-check"></i></div>
            <h1>Check your e-mail</h1>
            <p>If an account exists for <b style="color:var(--au-text)">@Model.Email</b>, we sent a 6-digit code.</p>
        </div>
        <div class="bb-auth-body">
            <form method="post" id="otpForm" asp-action="VerifyOtp">
                <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Code" id="otpValue" />
                <div class="otp-boxes" id="otpBoxes" dir="ltr">
                    @for (var i = 0; i < 6; i++)
                    {
                        <input type="text" inputmode="numeric" autocomplete="@(i == 0 ? "one-time-code" : "off")" maxlength="1" class="otp-box" aria-label="Digit @(i + 1)" />
                    }
                </div>
                <div class="text-center small text-secondary mt-3">Code expires in <b id="otpTimer" style="color:var(--au-text)">10:00</b></div>
                <button type="submit" class="btn btn-brand btn-lg w-100 mt-3" id="otpSubmit" disabled>Verify code</button>
            </form>

            <form method="post" asp-action="ResendOtp" class="text-center mt-3">
                <input type="hidden" name="email" value="@Model.Email" />
                <button type="submit" class="btn btn-link text-decoration-none" id="resendBtn" disabled>Resend code <span id="resendWait"></span></button>
                <div class="small text-secondary">A new code cancels the old one.</div>
            </form>
        </div>
        <div class="bb-auth-foot"><a asp-action="ForgotPassword" class="fw-semibold text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Use a different e-mail</a></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var boxes = Array.from(document.querySelectorAll('.otp-box')), hidden = document.getElementById('otpValue'), submit = document.getElementById('otpSubmit');
            function sync() {
                var v = boxes.map(function (b) { return b.value; }).join('');
                hidden.value = v; submit.disabled = v.length !== 6;
            }
            boxes.forEach(function (b, i) {
                b.addEventListener('input', function () {
                    b.value = b.value.replace(/\D/g, '').slice(-1);
                    if (b.value && boxes[i + 1]) boxes[i + 1].focus();
                    sync();
                    if (hidden.value.length === 6) document.getElementById('otpForm').requestSubmit();
                });
                b.addEventListener('keydown', function (e) {
                    if (e.key === 'Backspace' && !b.value && boxes[i - 1]) { boxes[i - 1].focus(); boxes[i - 1].value = ''; sync(); }
                    if (e.key === 'ArrowLeft' && boxes[i - 1]) boxes[i - 1].focus();
                    if (e.key === 'ArrowRight' && boxes[i + 1]) boxes[i + 1].focus();
                });
                b.addEventListener('paste', function (e) {
                    var t = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
                    if (!t) return; e.preventDefault();
                    t.split('').forEach(function (ch, k) { if (boxes[k]) boxes[k].value = ch; });
                    (boxes[Math.min(t.length, 5)]).focus(); sync();
                    if (t.length === 6) document.getElementById('otpForm').requestSubmit();
                });
            });
            boxes[0].focus();

            // countdowns: code lifetime (10 min) and resend cooldown (30 s)
            var end = Date.now() + 10 * 60 * 1000, resendAt = Date.now() + 30 * 1000;
            var timer = document.getElementById('otpTimer'), rb = document.getElementById('resendBtn'), rw = document.getElementById('resendWait');
            setInterval(function () {
                var left = Math.max(0, end - Date.now()), m = Math.floor(left / 60000), s = Math.floor(left % 60000 / 1000);
                timer.textContent = m + ':' + (s < 10 ? '0' : '') + s;
                var w = Math.ceil((resendAt - Date.now()) / 1000);
                if (w > 0) { rb.disabled = true; rw.textContent = '(' + w + 's)'; } else { rb.disabled = false; rw.textContent = ''; }
            }, 500);
        })();
    </script>
}
