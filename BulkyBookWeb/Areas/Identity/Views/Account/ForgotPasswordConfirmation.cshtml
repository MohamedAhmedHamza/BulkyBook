@{ ViewData["Title"] = "Check your e-mail"; }
<div class="bb-status">
    <div style="max-width:440px">
        <div class="bb-status-icon"><i class="bi bi-envelope-check"></i></div>
        <h1 class="h3 fw-bold mb-2">Check your e-mail</h1>
        <p class="text-secondary mb-4">If an account exists for that address, we've sent a link to reset your password.</p>
        <a class="btn btn-brand" asp-action="Login">Back to log in</a>
    </div>
</div>
