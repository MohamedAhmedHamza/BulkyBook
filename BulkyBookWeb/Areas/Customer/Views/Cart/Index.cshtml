@model ShoppingCartVM
@{
    ViewData["Title"] = "Your cart";
    var items = Model.ShoppingCartList.ToList();
    var units = items.Sum(i => i.Count);
}

<div class="container py-4" style="max-width:1140px">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
        <div>
            <h1 class="h3 fw-bold mb-0">Shopping cart</h1>
            <span class="text-secondary">@units @(units == 1 ? "item" : "items")</span>
        </div>
        <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="text-decoration-none fw-semibold">
            <i class="bi bi-arrow-left me-1"></i>Continue shopping
        </a>
    </div>

    @if (items.Count == 0)
    {
        <div class="bb-empty">
            <i class="bi bi-cart-x"></i>
            <h5 class="fw-bold mt-3">Your cart is empty</h5>
            <p class="text-secondary mb-3">Find something to read and it will show up here.</p>
            <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-brand">Browse books</a>
        </div>
    }
    else
    {
        <form method="post" id="checkoutForm">
            @* Default button for the Enter key, so Enter never triggers a +/- button below *@
            <button type="submit" class="visually-hidden" tabindex="-1" aria-hidden="true">Place order</button>

            <div class="row g-4 align-items-start">
                <div class="col-lg-7">
                    <div class="card overflow-hidden" style="border-radius:var(--bb-radius)">
                        @foreach (var item in items)
                        {
                            var nextHint = "";
                            if (item.Count <= 50 && item.Product.Price50 < item.Price)
                            {
                                nextHint = $"Add {51 - item.Count} more to pay {item.Product.Price50.ToString("c")} each";
                            }
                            else if (item.Count <= 100 && item.Product.Price100 < item.Price)
                            {
                                nextHint = $"Add {101 - item.Count} more to pay {item.Product.Price100.ToString("c")} each";
                            }
                            <div class="bb-cart-item">
                                <a class="bb-cart-thumb" asp-area="Customer" asp-controller="Home" asp-action="Details" asp-route-productId="@item.ProductId">
                                    @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                    {
                                        <img src="@Url.Content("~/" + item.Product.ImageUrl.TrimStart('/'))" alt="@item.Product.Title" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="d-flex h-100 align-items-center justify-content-center"><i class="bi bi-book fs-3 text-secondary"></i></span>
                                    }
                                </a>
                                <div class="flex-grow-1 min-w-0">
                                    <a class="fw-bold text-decoration-none d-block text-truncate" style="color:var(--bb-text)"
                                       asp-area="Customer" asp-controller="Home" asp-action="Details" asp-route-productId="@item.ProductId">@item.Product.Title</a>
                                    <div class="text-secondary small mb-2">by @item.Product.Author &middot; @item.Price.ToString("c") each</div>
                                    @if (nextHint.Length > 0)
                                    {
                                        <div class="bb-hint mb-2"><i class="bi bi-lightning-charge-fill me-1"></i>@nextHint</div>
                                    }
                                    <div class="d-flex flex-wrap align-items-center gap-3">
                                        <div class="bb-qty">
                                            <button type="submit" class="bb-qty-btn" aria-label="Decrease quantity" formnovalidate
                                                    formaction="@Url.Action("Minus", "Cart", new { area = "Customer", cartid = item.Id })"><i class="bi bi-dash-lg"></i></button>
                                            <input type="number" min="1" max="1000" value="@item.Count" aria-label="Quantity"
                                                   onchange="updateCart(@item.Id, this.value)" onkeydown="if(event.key==='Enter'){event.preventDefault();this.blur();}" />
                                            <button type="submit" class="bb-qty-btn" aria-label="Increase quantity" formnovalidate
                                                    formaction="@Url.Action("Plus", "Cart", new { area = "Customer", cartid = item.Id })"><i class="bi bi-plus-lg"></i></button>
                                        </div>
                                        <button type="submit" class="bb-link-danger" formnovalidate
                                                formaction="@Url.Action("Remove", "Cart", new { area = "Customer", cartid = item.Id })"><i class="bi bi-trash3 me-1"></i>Remove</button>
                                    </div>
                                </div>
                                <div class="fw-bold text-nowrap">@((item.Price * item.Count).ToString("c"))</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="card bb-summary" style="border-radius:var(--bb-radius)">
                        <div class="card-body p-4">
                            <h2 class="h6 fw-bold mb-3"><i class="bi bi-geo-alt me-2" style="color:var(--bb-brand)"></i>Shipping details</h2>
                            <div class="row g-2 mb-2">
                                <div class="col-12 col-sm-6">
                                    <input asp-for="OrderHeader.Name" class="form-control" placeholder="Full name" autocomplete="name" />
                                    <span asp-validation-for="OrderHeader.Name" class="text-danger small"></span>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <input asp-for="OrderHeader.PhoneNumber" class="form-control" placeholder="Phone" autocomplete="tel" />
                                    <span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="mb-2">
                                <input asp-for="OrderHeader.StreetAddress" class="form-control" placeholder="Street address" autocomplete="street-address" />
                                <span asp-validation-for="OrderHeader.StreetAddress" class="text-danger small"></span>
                            </div>
                            <div class="row g-2">
                                <div class="col-5">
                                    <input asp-for="OrderHeader.City" class="form-control" placeholder="City" />
                                    <span asp-validation-for="OrderHeader.City" class="text-danger small"></span>
                                </div>
                                <div class="col-3">
                                    <input asp-for="OrderHeader.State" class="form-control" placeholder="State" />
                                    <span asp-validation-for="OrderHeader.State" class="text-danger small"></span>
                                </div>
                                <div class="col-4">
                                    <input asp-for="OrderHeader.PostalCode" class="form-control" placeholder="ZIP" autocomplete="postal-code" />
                                    <span asp-validation-for="OrderHeader.PostalCode" class="text-danger small"></span>
                                </div>
                            </div>

                            <hr class="my-4" />
                            <h2 class="h6 fw-bold mb-3"><i class="bi bi-receipt me-2" style="color:var(--bb-brand)"></i>Order summary</h2>
                            @foreach (var item in items)
                            {
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-secondary text-truncate me-2">@item.Product.Title &times; @item.Count</span>
                                    <span class="fw-medium">@((item.Price * item.Count).ToString("c"))</span>
                                </div>
                            }
                            <div class="d-flex justify-content-between small mt-2">
                                <span class="text-secondary">Shipping</span>
                                <span class="fw-semibold" style="color:var(--bb-brand-600)">Free</span>
                            </div>
                            <hr />
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="fw-semibold">Total</span>
                                <span class="h4 fw-bold mb-0">@Model.OrderHeader.OrderTotal.ToString("c")</span>
                            </div>
                            <button type="submit" class="btn btn-brand btn-lg w-100"><i class="bi bi-lock me-2"></i>Pay securely with Stripe</button>
                            <div class="d-flex justify-content-center gap-3 mt-3 text-secondary" style="font-size:.75rem">
                                <span><i class="bi bi-shield-check me-1"></i>Secure payment</span>
                                <span><i class="bi bi-truck me-1"></i>Free shipping</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        function updateCart(cartId, count) {
            var token = document.querySelector('#checkoutForm input[name="__RequestVerificationToken"]');
            fetch('@Url.Action("UpdateCart", "Cart", new { area = "Customer" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token ? token.value : ''
                },
                body: 'cartId=' + encodeURIComponent(cartId) + '&count=' + encodeURIComponent(count)
            }).then(function (r) { if (r.ok) window.location.reload(); });
        }
    </script>
    <partial name="_ValidationScriptsPartial" />
}
