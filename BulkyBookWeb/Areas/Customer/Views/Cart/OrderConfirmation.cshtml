@model int
@{
    ViewData["Title"] = "Order confirmation";
    var paid = ViewBag.Paid is bool b && b;
}

<div class="bb-status">
    <div style="width:100%;max-width:460px">
        @if (paid)
        {
            <div class="bb-status-icon"><i class="bi bi-check-lg"></i></div>
            <h1 class="h3 fw-bold mb-2">Order confirmed!</h1>
            <p class="text-secondary mb-4">Thank you for your purchase. A confirmation e-mail is on its way and we are preparing your order.</p>
        }
        else
        {
            <div class="bb-status-icon warn"><i class="bi bi-hourglass-split"></i></div>
            <h1 class="h3 fw-bold mb-2">We're confirming your payment</h1>
            <p class="text-secondary mb-4">Your order is saved, but we could not confirm the payment yet. Refresh this page in a moment. If you were charged and nothing changes, contact support with the order number below.</p>
        }

        <div class="card mb-4" style="border-radius:var(--bb-radius)">
            <div class="card-body py-4">
                <div class="text-uppercase text-secondary fw-semibold" style="font-size:.7rem;letter-spacing:.1em">Order number</div>
                <div class="display-6 fw-bold" style="color:var(--bb-brand-600)">#@Model</div>
            </div>
        </div>

        <div class="d-grid gap-2">
            <a class="btn btn-brand" asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-orderId="@Model"><i class="bi bi-box-seam me-2"></i>View this order</a>
            <a class="btn btn-soft" asp-area="Customer" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-2"></i>Continue shopping</a>
        </div>
    </div>
</div>
