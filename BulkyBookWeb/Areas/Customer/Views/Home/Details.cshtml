@model ShoppingCart
@{
    var p = Model.Product;
    ViewData["Title"] = p.Title;
    var isAuth = User.Identity?.IsAuthenticated ?? false;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="container py-4">
    <nav class="bb-crumbs mb-3" aria-label="breadcrumb">
        <a asp-area="Customer" asp-controller="Home" asp-action="Index">Shop</a>
        <i class="bi bi-chevron-right mx-1 small"></i>
        <a asp-area="Customer" asp-controller="Home" asp-action="Index" asp-route-categoryId="@p.CategoryId">@p.Category?.Name</a>
        <i class="bi bi-chevron-right mx-1 small"></i>
        <span>@p.Title</span>
    </nav>

    <form method="post" class="bb-detail">
        <input type="hidden" asp-for="ProductId" />
        <div class="row g-0">
            <div class="col-lg-5">
                <div class="bb-detail-media h-100">
                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                    {
                        <img src="@Url.Content("~/" + p.ImageUrl.TrimStart('/'))" alt="@p.Title" />
                    }
                    else
                    {
                        <div class="text-center text-secondary"><i class="bi bi-book" style="font-size:7rem"></i><p class="small mt-2">No image available</p></div>
                    }
                </div>
            </div>

            <div class="col-lg-7 p-4 p-lg-5">
                <span class="badge rounded-pill mb-3" style="background:var(--bb-brand-soft);color:var(--bb-brand-600)">
                    <i class="bi bi-bookmark me-1"></i>@p.Category?.Name
                </span>
                <h1 class="h2 fw-bold mb-1" style="letter-spacing:-.02em">@p.Title</h1>
                <p class="text-secondary mb-1">by <span class="fw-semibold" style="color:var(--bb-text)">@p.Author</span></p>
                <p class="text-secondary small mb-4">ISBN: @p.ISBN</p>

                <div class="d-flex align-items-baseline gap-2 mb-4">
                    <span class="h2 fw-bold mb-0" id="unitPrice" style="color:var(--bb-brand-600)">@p.Price.ToString("c")</span>
                    @if (p.ListPrice > p.Price)
                    {
                        <span class="text-decoration-line-through text-secondary">@p.ListPrice.ToString("c")</span>
                        <span class="badge text-bg-success">Save @((int)Math.Round((1 - p.Price / p.ListPrice) * 100))%</span>
                    }
                </div>

                <div class="mb-4">
                    <p class="text-uppercase fw-bold text-secondary mb-2" style="font-size:.7rem;letter-spacing:.08em">
                        <i class="bi bi-stack me-1" style="color:var(--bb-brand)"></i>Volume pricing
                    </p>
                    <div class="row g-2">
                        <div class="col-4"><div class="bb-tier" id="tier1"><small>1–50</small><b>@p.Price.ToString("c")</b></div></div>
                        <div class="col-4"><div class="bb-tier" id="tier2"><small>51–100</small><b>@p.Price50.ToString("c")</b></div></div>
                        <div class="col-4"><div class="bb-tier" id="tier3"><small>100+</small><b>@p.Price100.ToString("c")</b></div></div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(p.Description))
                {
                    @* Description is authored by Admin in the product editor and may contain HTML. *@
                    <div class="text-secondary mb-4">@Html.Raw(p.Description)</div>
                }

                <div class="d-flex flex-wrap align-items-center gap-3">
                    <div class="bb-qty" role="group" aria-label="Quantity">
                        <button type="button" class="bb-qty-btn" id="qtyMinus" aria-label="Decrease"><i class="bi bi-dash-lg"></i></button>
                        <input asp-for="Count" type="number" min="1" max="1000" id="qty" aria-label="Quantity" />
                        <button type="button" class="bb-qty-btn" id="qtyPlus" aria-label="Increase"><i class="bi bi-plus-lg"></i></button>
                    </div>
                    @if (isAuth)
                    {
                        <button type="submit" class="btn btn-brand btn-lg flex-grow-1 py-2"><i class="bi bi-cart-plus me-2"></i>Add to cart</button>
                    }
                    else
                    {
                        <a class="btn btn-brand btn-lg flex-grow-1 py-2" asp-area="Identity" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Log in to add to cart
                        </a>
                    }
                </div>
                <p class="mt-3 mb-0 fw-semibold" id="lineTotal" style="font-size:.95rem"></p>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var p1 = @p.Price.ToString(System.Globalization.CultureInfo.InvariantCulture),
                p2 = @p.Price50.ToString(System.Globalization.CultureInfo.InvariantCulture),
                p3 = @p.Price100.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var qty = document.getElementById('qty');
            function clamp() { var v = parseInt(qty.value, 10); if (isNaN(v) || v < 1) v = 1; if (v > 1000) v = 1000; return v; }
            function paint() {
                var n = clamp(), unit = n <= 50 ? p1 : (n <= 100 ? p2 : p3);
                document.getElementById('tier1').classList.toggle('active', n <= 50);
                document.getElementById('tier2').classList.toggle('active', n > 50 && n <= 100);
                document.getElementById('tier3').classList.toggle('active', n > 100);
                document.getElementById('lineTotal').textContent =
                    n + ' × ' + unit.toLocaleString(undefined, { style: 'currency', currency: 'USD' }) +
                    ' = ' + (unit * n).toLocaleString(undefined, { style: 'currency', currency: 'USD' });
            }
            document.getElementById('qtyMinus').onclick = function () { qty.value = Math.max(1, clamp() - 1); paint(); };
            document.getElementById('qtyPlus').onclick = function () { qty.value = Math.min(1000, clamp() + 1); paint(); };
            qty.addEventListener('input', paint);
            qty.addEventListener('blur', function () { qty.value = clamp(); paint(); });
            paint();
        })();
    </script>
}
