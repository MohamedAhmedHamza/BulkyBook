@model ProductListVM
@{
    var covers = Model.Products.Where(p => !string.IsNullOrEmpty(p.ImageUrl)).Take(3).ToList();
}
<section class="bb-hero">
    <div class="container py-5">
        <div class="row align-items-center g-5 py-lg-4">
            <div class="col-lg-6">
                <span class="bb-eyebrow"><i class="bi bi-stars"></i> Your online bookstore</span>
                <h1 class="mt-3 mb-3">Find your next <em>great read</em></h1>
                <p class="lead mb-4 text-secondary" style="max-width:34rem">
                    Browse the catalog, compare prices and save more when you order in bulk.
                </p>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <a href="#catalog" class="btn btn-brand btn-lg px-4"><i class="bi bi-book me-2"></i>Browse books</a>
                    @if (!(User.Identity?.IsAuthenticated ?? false))
                    {
                        <a asp-area="Identity" asp-controller="Account" asp-action="Register" class="btn btn-soft btn-lg px-4">Create account</a>
                    }
                </div>
                <div class="d-flex gap-4">
                    <div class="bb-stat"><b>@Model.TotalBooks</b><span>Books</span></div>
                    <div class="bb-stat"><b>@Model.Categories.Count()</b><span>Categories</span></div>
                    <div class="bb-stat"><b><i class="bi bi-truck"></i></b><span>Bulk pricing</span></div>
                </div>
            </div>
            <div class="col-lg-6">
                @if (covers.Count > 0)
                {
                    <div class="bb-covers">
                        @foreach (var c in covers)
                        {
                            <img class="bb-cover" src="@Url.Content("~/" + c.ImageUrl!.TrimStart('/'))" alt="@c.Title" loading="lazy" />
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>
